---

import Layout from "../layouts/Layout.astro"
import {App} from "wpt-viewer/Components/App"

---

<Layout>
    <main>
        <div>
            <App client:only />
        </div>
    </main>
</Layout>

<script>
import { initializeSource, loadConfig } from "wpt-viewer/Config";
import { initFromUrlParams } from "wpt-viewer/Routing";

const domain = window.location.origin

await loadConfig(domain + "/config.json");
initFromUrlParams();
await initializeSource();
</script>

<style>
    main {
        height: 100vh;
        width: 100vw;
    }

    div {
        display: flex;
        justify-content: safe center;
    }
</style>