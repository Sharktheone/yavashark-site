---
import Site from "../layouts/Site.astro";
import Logo from "../components/Logo.astro";
import Playground from "../components/Playground.astro";
import Test262 from "../components/Test262.astro";
---

<Site>
    <header class="hero">
        <div class="hero-title">
            <h1>Yavashark</h1>
            <p>An experimental JS Engine</p>
        </div>
        <Logo id="hero-logo" class="hero-logo" label="Yavashark logo" hop="click" />
        <Playground />
    </header>

    <Test262 />
</Site>

<style>
    .hero {
        display: grid;
        grid-template-areas: "logo" "title" "runner";
        justify-items: center;
        gap: 1rem;
        margin-top: 2rem;
        text-align: center;
        --runner-h: 28rem;
    }

    .hero-title {
        grid-area: title;
        margin-bottom: 8rem;
        margin-top: 4rem;
    }

    /* Clicking it plays the morph (SVG <animate>, see Logo.astro). */
    .hero :global(.hero-logo) {
        grid-area: logo;
        width: clamp(4rem, 24rem, min(70vw, 70vh));
        aspect-ratio: 1;
        cursor: pointer;
    }

    .hero :global(.pg-slot) {
        grid-area: runner;
    }

    h1 {
        margin: 0;
        font-size: 6rem;
        line-height: 1.1;
        letter-spacing: -0.02em;
    }

    .hero-title p {
        margin: 1rem 0 0;
        color: var(--muted);
        font-size: 1.5rem;
    }

    @media (max-width: 600px) {
        .hero {
            --runner-h: 32rem;
        }

        h1 {
            font-size: 2.4rem;
        }
    }
</style>
