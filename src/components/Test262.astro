---
import { SERIES } from "./test262-series";

const ranges = [
    { id: "90", label: "3m" },
    { id: "365", label: "1y" },
    { id: "all", label: "all" },
];
---

<section class="t2 box" id="test262" data-state="loading">
    <div class="t2-controls">
        <div class="t2-left">
        <fieldset class="seg">
            <legend class="visually-hidden">Scale</legend>
            <label><input class="visually-hidden" type="radio" name="t2-mode" value="count" checked /><span>count</span></label>
            <label><input class="visually-hidden" type="radio" name="t2-mode" value="share" /><span>%</span></label>
        </fieldset>
        <span class="t2-hint">drag to zoom · double-click to reset</span>
        </div>
        <div class="t2-right">
            <button class="t2-reset" type="button" hidden title="Reset zoom">reset zoom</button>
            <fieldset class="seg">
                <legend class="visually-hidden">Time range</legend>
                {ranges.map((r) => (
                    <label>
                        <input class="visually-hidden" type="radio" name="t2-range" value={r.id} checked={r.id === "all"} />
                        <span>{r.label}</span>
                    </label>
                ))}
            </fieldset>
        </div>
    </div>

    <fieldset class="t2-legend">
        <legend class="visually-hidden">Shown results</legend>
        {SERIES.map((s, i) => (
            <label class="chip" style={`--color: var(--c${i + 1})`}>
                <input class="visually-hidden" type="checkbox" name="t2-series" value={s.key} checked />
                <i></i>
                <span>{s.label}</span>
                <b data-value={s.key}></b>
            </label>
        ))}
    </fieldset>

    <div class="t2-plot">
        <svg class="t2-svg" tabindex="0" role="img" aria-label="test262 results over time"></svg>
        <div class="t2-tip" hidden></div>
    </div>
</section>

<style>
    .t2 {
        margin-top: 3rem;
        padding: 1rem 1.25rem 0.75rem;
        font-size: 0.85rem;
    }

    fieldset {
        margin: 0;
        padding: 0;
        border: 0;
    }

    .t2-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .t2-left {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }

    .t2-right {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .seg {
        display: flex;
        padding: 2px;
        border: 1px solid var(--border);
        border-radius: 7px;
    }

    .seg span {
        display: block;
        padding: 0.1rem 0.6rem;
        border-radius: 5px;
        color: var(--muted);
        cursor: pointer;
    }

    .seg span:hover {
        color: var(--fg);
    }

    .seg input:checked + span {
        background: color-mix(in oklch, var(--fg) 10%, transparent);
        color: var(--fg);
    }

    .seg input:focus-visible + span,
    .chip input:focus-visible ~ span {
        outline: 2px solid var(--fg);
        outline-offset: 1px;
    }

    .t2-reset {
        padding: 0;
        border: 0;
        background: none;
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
        cursor: pointer;
    }

    .t2-reset[hidden] {
        display: none;
    }

    .t2-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 0.4rem;
        margin: 0.9rem 0 0.75rem;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.55rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        cursor: pointer;
        user-select: none;
        transition: opacity 0.15s;
    }

    .chip:hover {
        border-color: var(--muted);
    }

    .chip i {
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        background: var(--color);
    }

    .chip b {
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    .chip:has(input:not(:checked)) {
        opacity: 0.45;
    }

    .chip:has(input:not(:checked)) i {
        background: none;
        box-shadow: inset 0 0 0 1.5px var(--color);
    }

    .t2-plot {
        position: relative;
        height: 340px;
    }

    .t2-svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
        touch-action: pan-y;
        cursor: crosshair;
        user-select: none;
    }

    .t2-svg:focus-visible {
        outline: 1px dashed var(--muted);
        outline-offset: 4px;
    }

    .t2-hint {
        color: var(--muted);
        font-size: 0.75rem;
    }

    .t2-svg :global(.grid) {
        stroke: var(--border);
        shape-rendering: crispEdges;
    }

    .t2-svg :global(.tick) {
        fill: var(--muted);
        font: 11px var(--mono);
    }

    .t2-svg :global(.band) {
        fill-opacity: 0.75;
    }

    .t2-svg :global(.edge) {
        fill: none;
        stroke-width: 1.25;
        stroke-linejoin: round;
    }

    .t2-svg :global(.sel) {
        fill: var(--fg);
        fill-opacity: 0.08;
        stroke: var(--fg);
        stroke-opacity: 0.3;
    }

    .t2-svg :global(.cross) {
        stroke: var(--fg);
        stroke-opacity: 0.55;
        shape-rendering: crispEdges;
    }

    .t2-svg :global(.dot) {
        stroke: var(--panel);
        stroke-width: 2;
    }

    .t2-tip {
        position: absolute;
        top: 0.25rem;
        z-index: 2;
        padding: 0.35rem 0.55rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--panel);
        box-shadow: 0 4px 14px oklch(0 0 0 / 0.12);
        font: 0.75rem/1.45 var(--mono);
        white-space: nowrap;
        pointer-events: none;
    }

    .t2-tip :global(span) {
        color: var(--muted);
    }

    @media (max-width: 600px) {
        .t2 {
            padding-inline: 0.85rem;
        }

        .t2-plot {
            height: 260px;
        }

        .t2-hint {
            display: none;
        }
    }
</style>

<script>
    import { mountChart } from "./test262-chart";

    mountChart(document.querySelector<HTMLElement>(".t2")!);
</script>
